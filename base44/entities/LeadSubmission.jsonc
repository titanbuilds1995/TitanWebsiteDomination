{
  "name": "LeadSubmission",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Lead's full name"
    },
    "phone": {
      "type": "string",
      "description": "Lead's phone number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Lead's email address"
    },
    "property_address": {
      "type": "string",
      "description": "Address of the property"
    },
    "message": {
      "type": "string",
      "description": "Additional message or details"
    },
    "source": {
      "type": "string",
      "enum": [
        "hero_form",
        "contact_form"
      ],
      "description": "Where the lead came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed",
        "not_interested"
      ],
      "default": "new",
      "description": "Lead status"
    }
  },
  "required": [
    "full_name",
    "phone",
    "property_address"
  ]
}